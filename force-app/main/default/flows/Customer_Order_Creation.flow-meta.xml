<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Guides a sales user through customer and product selection, then creates and submits the order through the secure bulk-safe Apex action.</description>
    <dynamicChoiceSets>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <name>Customer_Choices</name>
        <object>Customer__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <name>Product_Choices</name>
        <object>Product__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <interviewLabel>Create Customer Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Customer Order</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Order_Details</name>
        <label>Order Details</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <connector><targetReference>Create_Customer_Order</targetReference></connector>
        <fields>
            <name>Selected_Customer</name>
            <choiceReferences>Customer_Choices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select Customer</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Selected_Product</name>
            <choiceReferences>Product_Choices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Select Product</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Quantity</name>
            <dataType>Number</dataType>
            <defaultValue><numberValue>1.0</numberValue></defaultValue>
            <fieldText>Quantity</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>0</scale>
        </fields>
        <nextOrFinishButtonLabel>Submit Order</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Order_Created</name>
        <label>Order Submitted</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <fields>
            <name>Order_Created_Message</name>
            <fieldText>&lt;p&gt;Your order was created and submitted. Its status reflects any required approval and inventory checks.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <actionCalls>
        <name>Create_Customer_Order</name>
        <label>Create Customer Order</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <actionName>OrderCreationFlowAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customerId</name>
            <value><elementReference>Selected_Customer</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>productId</name>
            <value><elementReference>Selected_Product</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>quantity</name>
            <value><elementReference>Quantity</elementReference></value>
        </inputParameters>
        <connector><targetReference>Order_Created</targetReference></connector>
    </actionCalls>
    <start><locationX>50</locationX><locationY>0</locationY><connector><targetReference>Order_Details</targetReference></connector></start>
    <status>Active</status>
</Flow>
