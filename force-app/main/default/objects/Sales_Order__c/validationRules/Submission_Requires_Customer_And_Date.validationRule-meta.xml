<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Submission_Requires_Customer_And_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Order_Status__c, &quot;Submitted&quot;), OR(ISBLANK(Customer__c), ISBLANK(Order_Date__c)))</errorConditionFormula>
    <errorMessage>Select a customer and order date before submitting an order.</errorMessage>
</ValidationRule>
