<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Nonnegative_Inventory_Values</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Unit_Price__c &lt; 0, Available_Quantity__c &lt; 0, Reorder_Level__c &lt; 0)</errorConditionFormula>
    <errorMessage>Price, available quantity, and reorder level cannot be negative.</errorMessage>
</ValidationRule>
